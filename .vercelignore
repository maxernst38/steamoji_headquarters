# Keep the deployment to what a read-only site actually imports.
# The analysis stack, the footage and the working data stay out of it.
# tools/ is NOT excluded: the build command lives there.

data/
videos/
docs/
archive/
training/
detection/
# The simulator's field is drawn from calibration/field_layout.py, so that one
# module ships. It imports OpenCV only inside the two functions that need it,
# which is what makes it safe to keep here; the rest of the package does not.
calibration/*.py
!calibration/__init__.py
!calibration/field_layout.py
calibration/__pycache__/
calibration/README.md
deploy/
pipeline.py
track.py
calibrate.py
ui.py
environment.yml
requirements-web.txt
*.ipynb
